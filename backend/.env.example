# Copy this file to .env and fill in your local values
PORT=5000
CORS_ORIGIN=http://127.0.0.1:5500
DB_ENGINE=sqlite
SQLITE_PATH=portfolio_weirdos.db

# SQLite is active by default using the settings above.
# To switch to MySQL, set DB_ENGINE=mysql and fill in the MySQL block below.
# DB_ENGINE=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=portfolio_weirdos

# Secret key for Flask session signing - change this to a long random value
# in production (e.g. python -c "import secrets; print(secrets.token_hex(32))").
SECRET_KEY=change-me-to-a-random-secret

# Email settings (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_username
SMTP_PASSWORD=your_password
SMTP_FROM=no-reply@portfoleo.local
SMTP_USE_SSL=true
SMTP_STARTTLS=false
ACTIVATION_BASE_URL=http://127.0.0.1:5500

# Cloudinary (profile picture uploads) - get these from
# https://console.cloudinary.com/console -> Dashboard -> Account details
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
